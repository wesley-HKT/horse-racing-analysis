# Local research data. This directory is ignored by Git and must not be served by the frontend.
HORSE_RACING_RESEARCH_DIR=.local-research

# Use only when a separately deployed backend is available.
# VITE_API_BASE_URL=https://api.example.com

# Experimental recent-race snapshots are disabled by default.
# All VITE_* values are public in the browser bundle; never place secrets here.
VITE_ENABLE_RECENT_RACES=false
VITE_RECENT_RACES_SNAPSHOT_URL=data/recent-races.snapshot.json

# Optional locally exported historical research summary.
VITE_ENABLE_RESEARCH_SUMMARY=false
VITE_RESEARCH_SUMMARY_URL=data/research-summary.json

# The local connector refuses network access unless its explicit CLI flag is supplied.
HORSE_RACING_ENABLE_RECENT_CONNECTOR=false
